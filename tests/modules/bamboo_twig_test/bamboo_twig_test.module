<?php

/**
 * @file
 * Primary module hooks for Bamboo Twig test module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\bamboo_twig_test\Hook\BambooTwigTestThemeHook;

/**
 * Implements hook_theme().
 *
 * Legacy shim for Drupal < 11.1, see BambooTwigTestThemeHook.
 */
#[LegacyHook]
function bamboo_twig_test_theme($existing, $type, $theme, $path) {
  return \Drupal::service(BambooTwigTestThemeHook::class)();
}
