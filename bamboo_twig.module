<?php

/**
 * @file
 * Contains includes hook to generate help page.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\bamboo_twig\Hook\BambooTwigHelpHook;

/**
 * Implements hook_help().
 *
 * Legacy shim for Drupal < 11.1, see BambooTwigHelpHook.
 */
#[LegacyHook]
function bamboo_twig_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(BambooTwigHelpHook::class)($route_name, $route_match);
}
